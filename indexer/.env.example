# Postgres
DATABASE_URL=postgres://user:pass@localhost:5432/charity_indexer

# Chain
RPC_URL=http://127.0.0.1:8545        # http(s):// or ws(s):// ; ws recommended for low-latency live
CHAIN_ID=31337

# Deployed contract addresses (from scripts/deploy.ts output), any case — normalised to lowercase
ESCROW_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
REGISTRY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
VOTING_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
PROOFS_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# Block the escrow was deployed at. Replaying from 0 on a real network is a mistake.
START_BLOCK=0
LABEL=local

# Tuning (defaults shown)
# CONFIRMATIONS: keep 0 for a local Hardhat node (its head stops advancing when
# idle, so any gap strands the newest blocks — e.g. Donated). Use 5+ on a public
# network. Omitting it auto-selects 0 for a localhost RPC, 5 otherwise.
CONFIRMATIONS=0
# LOG_BATCH_SIZE: max blocks per eth_getLogs call during replay. Set to your RPC
# provider's documented limit — Alchemy free tier = 10, Alchemy paid = 2000,
# Infura = 10000. Default is 10 (safe for the free tier). Bigger = faster replay.
# (Old name CHUNK_SIZE still works but warns.)
LOG_BATCH_SIZE=10
POLL_INTERVAL_MS=15000
RECONCILE_INTERVAL_MS=300000
