# ── /api server config ──────────────────────────────────────────────────────
# This is a SEPARATE process from /indexer with its OWN connection pool. It only
# ever reads the database; the indexer keeps writing to it independently.

# Postgres — same database the indexer fills, but a distinct pool instance.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/charity_indexer

# Which deployment (wired 4-contract set) this API serves. Resolved once at
# startup to a deployments.id; every query filters on it. Must match a row
# created by `npm run indexer:register`.
CHAIN_ID=31337
ESCROW_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# HTTP
PORT=4000
# Comma-separated allowed origins for the browser dApp, or * for any.
CORS_ORIGIN=*

# ── Pinata (server-side only — NEVER sent to or read by the frontend) ───────
# Create a JWT at https://app.pinata.cloud/developers/api-keys with pinFileToIPFS
# scope. Leave blank to disable POST /proofs/upload (it will 503).
PINATA_JWT=
# Optional dedicated gateway host for building a preview URL in the response,
# e.g. my-gateway.mypinata.cloud . Falls back to gateway.pinata.cloud.
PINATA_GATEWAY=
# Max upload size in bytes (default 10 MiB).
MAX_UPLOAD_BYTES=10485760
